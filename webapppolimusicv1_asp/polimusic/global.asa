<script language="VBScript" runat="Server">

Sub Application_OnStart()
    Application("APP_NAME") = "PoliMusic"
    Application("APP_VERSION") = "1.0"
    Application("SESSION_TIMEOUT") = 30
    Application("INICIADA_EN") = Now()
End Sub

Sub Session_OnStart()
    Session.Timeout = 30
End Sub

Sub Session_OnEnd()
End Sub

Sub Application_OnEnd()
End Sub

</script>
