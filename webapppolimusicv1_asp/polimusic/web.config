<?xml version="1.0" encoding="UTF-8"?>
<!--
  PoliMusic - Configuracion de IIS
  ============================================================================
  Este archivo define el comportamiento de la aplicacion cuando se publica
  bajo IIS (Internet Information Services) en C:\inetpub\wwwroot\polimusic.

  IMPORTANTE sobre ASP Clasico:
  La seccion <system.webServer/asp> esta BLOQUEADA a nivel de servidor en
  muchas instalaciones de IIS (overrideModeDefault="Deny"). Declararla aqui
  provoca el error "Esta seccion de configuracion no puede utilizarse en esta
  ruta" y IIS responde HTTP 501 a TODAS las peticiones.

  Por ese motivo, la configuracion de ASP (enableParentPaths, codePage,
  scriptErrorSentToBrowser, session) NO se declara en este archivo: se aplica
  a nivel de servidor con appcmd desde los scripts de despliegue:
     deploy-iis.ps1 / reparar-iis.ps1 / verificar-iis.ps1

  Aspectos SI configurados aqui (secciones desbloqueadas por defecto):
    - Documento predeterminado: login.asp se sirve al acceder a la raiz.
    - Codificacion de respuesta y cabeceras de seguridad.
    - Tipos MIME para los recursos multimedia del catalogo.
    - Errores personalizados.
    - Proteccion del codigo fuente de la carpeta _includes.
-->
<configuration>

  <system.webServer>

    <!-- Documento predeterminado de la aplicacion -->
    <defaultDocument enabled="true">
      <files>
        <clear />
        <add value="login.asp" />
        <add value="dashboard.asp" />
        <add value="index.asp" />
      </files>
    </defaultDocument>

    <!-- Cabeceras de seguridad y codificacion -->
    <httpProtocol>
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options" value="SAMEORIGIN" />
        <add name="Referrer-Policy" value="same-origin" />
      </customHeaders>
    </httpProtocol>

    <!-- Tipos MIME necesarios para los recursos multimedia del catalogo -->
    <staticContent>
      <remove fileExtension=".mp3" />
      <mimeMap fileExtension=".mp3" mimeType="audio/mpeg" />
      <remove fileExtension=".m4a" />
      <mimeMap fileExtension=".m4a" mimeType="audio/mp4" />
      <remove fileExtension=".wav" />
      <mimeMap fileExtension=".wav" mimeType="audio/wav" />
      <remove fileExtension=".webp" />
      <mimeMap fileExtension=".webp" mimeType="image/webp" />
    </staticContent>

    <!-- Compresion de respuestas para acelerar la entrega -->
    <urlCompression doStaticCompression="true" doDynamicCompression="true" />

    <!-- Cabeceras de cache para los recursos estaticos -->
    <caching>
      <profiles>
        <add extension=".css" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
        <add extension=".js"  policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
        <add extension=".png" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
        <add extension=".jpg" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
        <add extension=".mp3" policy="CacheUntilChange" kernelCachePolicy="CacheUntilChange" />
      </profiles>
    </caching>

    <!-- Proteccion del codigo fuente del servidor.
         IMPORTANTE: la carpeta _includes NO se oculta con hiddenSegments. Las paginas
         usan #include virtual (resolucion del motor ASP), pero ocultar el segmento
         puede interferir con la resolucion en algunas configuraciones de IIS. La
         proteccion real la aporta la propia extension .asp: los fragmentos se ejecutan
         en el servidor y nunca se descargan como texto. Solo se bloquea _logs. -->
    <security>
      <requestFiltering>
        <hiddenSegments>
          <add segment="_logs" />
        </hiddenSegments>
        <fileExtensions>
          <remove fileExtension=".sql" />
          <add fileExtension=".sql" allowed="false" />
          <remove fileExtension=".md" />
          <add fileExtension=".md" allowed="false" />
          <remove fileExtension=".log" />
          <add fileExtension=".log" allowed="false" />
        </fileExtensions>
      </requestFiltering>
    </security>

    <!-- Paginas de error personalizadas -->
    <httpErrors errorMode="Custom" existingResponse="PassThrough">
      <remove statusCode="404" subStatusCode="-1" />
      <remove statusCode="500" subStatusCode="-1" />
      <error statusCode="404" path="/polimusic/login.asp" responseMode="Redirect" />
    </httpErrors>

  </system.webServer>

</configuration>
